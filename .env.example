#############################################
# DocFlow Enterprise — Environment Template
#
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง:
#   cp .env.example .env.local
# ห้าม commit .env.local (มีค่าลับ) — ไฟล์ .env.example นี้ไม่มีค่าลับ ปลอดภัยที่จะ commit
#############################################

# --- Database (PostgreSQL) -----------------
# รูปแบบ: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/docflow?schema=public"

# (ทางเลือก) direct connection สำหรับ prisma migrate เมื่อ DATABASE_URL เป็น pooler
# DIRECT_URL="postgresql://user:password@localhost:5432/docflow?schema=public"

# --- Application ---------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Auth / Session ------------------------
# สร้างด้วย: openssl rand -base64 48
AUTH_SECRET=""
SESSION_MAX_AGE="604800"

# --- File Storage --------------------------
# "local" (dev) หรือ "s3" (production / S3-compatible)
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./storage/uploads"

# S3-compatible (AWS S3 / Cloudflare R2 / MinIO) — ใช้เมื่อ STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="docflow"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# --- Upload limits -------------------------
# ขนาดไฟล์สูงสุดต่อไฟล์ (bytes) — 50 MB
MAX_UPLOAD_SIZE="52428800"

# --- Demo mode -----------------------------
# "true" = เปิด quick-login (คลิกเลือก user ตาม role ไม่ต้องใส่รหัส) สำหรับหน้า demo
# ⚠️ อย่าตั้ง true บน production ที่มีข้อมูลจริง — ใครก็ login เป็น admin ได้
DEMO_MODE="false"

# --- Seed (ข้อมูลตัวอย่างสำหรับ dev) --------
SEED_ADMIN_EMAIL="admin@docflow.local"
SEED_ADMIN_PASSWORD=""
SEED_USER_PASSWORD=""
